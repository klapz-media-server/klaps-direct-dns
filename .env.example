# Zone servie par le DNS intégré, et base des sous-domaines <hash>.klapz.direct
BASE_DOMAIN=klapz.direct

# Secret du HMAC token -> hash. NE JAMAIS LE CHANGER une fois en prod (tous les hash changeraient).
# Générer avec : openssl rand -hex 32
HASH_SECRET=change-moi
HASH_LENGTH=20

# Certificat pour *.<hash>.klapz.direct + <hash>.klapz.direct
WILDCARD=true

# staging (par défaut, pour tester sans quota) | production | URL d'un autre serveur ACME
ACME_DIRECTORY=staging
ACME_EMAIL=

# Stockage : data/certs/ab/cd/<hash>.bin + data/account.json
DATA_DIR=./data
CACHE_MAX_MB=50
RENEW_BEFORE_DAYS=30

# API HTTP
LISTEN_ADDR=0.0.0.0:8080

# DNS intégré (off pour le désactiver)
DNS_LISTEN=0.0.0.0:53
DNS_NS=ns1.klapz.direct
DNS_NS_IPS=203.0.113.10

# Optionnel : publier aussi les TXT chez Cloudflare (inutile avec le DNS intégré)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DNS_PROPAGATION_SECONDS=0
