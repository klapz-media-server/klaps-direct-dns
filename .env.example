# Zone served by the built-in DNS server, and base for <hash>.klapz.direct subdomains
BASE_DOMAIN=klapz.direct

# Secret for the token -> hash HMAC. NEVER change it once in production (every hash would change).
# Generate with: openssl rand -hex 32
HASH_SECRET=change-me
HASH_LENGTH=20

# Exact number of characters a token must have (other lengths get a 400)
TOKEN_LENGTH=32

# Certificate for *.<hash>.klapz.direct + <hash>.klapz.direct
WILDCARD=true

# staging (default, for testing without quota) | production | URL of another ACME server
ACME_DIRECTORY=staging
ACME_EMAIL=

# Storage: data/certs/ab/cd/<hash>.bin + data/account.json
DATA_DIR=./data
CACHE_MAX_MB=50
RENEW_BEFORE_DAYS=30

# HTTP API
LISTEN_ADDR=0.0.0.0:8080

# Built-in DNS server (set to off to disable)
DNS_LISTEN=0.0.0.0:53
DNS_NS=ns1.klapz.direct
DNS_NS_IPS=203.0.113.10

# Optional: also publish TXT records on Cloudflare (not needed with the built-in DNS)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DNS_PROPAGATION_SECONDS=0
